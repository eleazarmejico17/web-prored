# Libro de Reclamaciones — variables de entorno.
# Copiar a ".env" y completar. NUNCA commitear el archivo .env real.

# MySQL (cPanel → "Bases de datos MySQL")
DB_HOST=localhost
DB_NAME=cpaneluser_prored_libro
DB_USER=cpaneluser_prored
DB_PASS=CAMBIAR_PASSWORD

# URL pública del sitio, sin barra final (links de constancia y correo)
BASE_URL=https://tudominio.com

# Correo (opcional). MAIL_ENABLED=true solo si MAIL_FROM es válido.
MAIL_ENABLED=false
MAIL_FROM=libro@tudominio.com
# Copia de aviso al admin en cada nuevo registro (vacio = sin copia)
MAIL_ADMIN=
MAIL_FROM_NAME=ProRed - Libro de Reclamaciones
