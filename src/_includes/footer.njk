<footer>
    <div class="container">
        <div class="footer-content">
            <div class="footer-section">
                <img src="{{ pathPrefix }}public/assets/img/logo-ProRed.png" alt="ProRed Logo" style="width: 14rem;" />
                <p>Internet 100% fibra óptica en Concepción. Conectando tu futuro.</p>
                <div style="margin-top: 15px;">
                    <a href="{{ site.social.facebook }}" style="display: inline-block; margin-right: 15px; font-size: 1.5rem;" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <i class="fab fa-facebook"></i>
                    </a>
                    <a href="{{ site.social.instagram }}" style="display: inline-block; margin-right: 15px; font-size: 1.5rem;" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="{{ site.social.tiktok }}" style="display: inline-block; font-size: 1.5rem;" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                        <i class="fab fa-tiktok"></i>
                    </a>
                </div>
            </div>

            <div class="footer-section">
                <h4>Enlaces Rápidos</h4>
                <ul>
                    {% for link in site.footerLinks %}
                    <li><a href="{{ pathPrefix }}{{ link.href }}">{{ link.label }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <div class="footer-section">
                <h4>Contacto</h4>
                <ul>
                    <li><i class="fas fa-map-marker-alt"></i> {{ site.address }}</li>
                    <li><i class="fas fa-phone"></i> {{ site.contact.landline }}</li>
                    <li><i class="fas fa-envelope"></i> {{ site.contact.salesEmail }}</li>
                    {% for number in site.whatsappDisplay %}
                    <li><i class="fab fa-whatsapp"></i> {{ number }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="footer-section">
                <h4>Horario de Atención</h4>
                <ul>
                    {% for line in site.schedule %}
                    <li>{{ line }}</li>
                    {% endfor %}
                    <li style="margin-top: 10px; color: #E58E21;">{{ site.scheduleBadge }}</li>
                </ul>
                <a href="{{ pathPrefix }}libro-reclamaciones/" title="Ir al Libro de Reclamaciones">
                    <img src="{{ pathPrefix }}public/assets/img/libro_de_reclamaciones.png" alt="Libro de Reclamaciones" style="margin-top: 15px; width: 100%; max-width: 180px; height: auto;" />
                </a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; {{ site.legal.copyrightYear }} {{ site.name }}. Todos los derechos reservados.</p>
            <p>Razón Social: {{ site.legal.company }} | RUC: {{ site.legal.ruc }}</p>
        </div>
    </div>
</footer>
